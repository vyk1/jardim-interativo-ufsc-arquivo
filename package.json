{
  "name": "jardim-interativo-ufsc",
  "version": "2.0.0",
  "author": {
    "name": "Victoria Botelho Martins"
  },
  "engineStrict": true,
  "engines": {
    "node": "12"
  },
  "private": true,
  "dependencies": {
    "bootstrap": "^4.6.1",
    "browser-image-compression": "^1.0.17",
    "firebase": "^7.8.1",
    "font-awesome": "^4.7.0",
    "moment": "2.24.0",
    "node-sass": "^4.14.1",
    "qrcode.react": "^1.0.1",
    "re-base": "^4.0.0",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^1.2.2",
    "react-router": "5.0.1",
    "react-router-dom": "5.0.1",
    "react-scripts": "3.0.1",
    "react-table": "^7.7.0",
    "reactstrap": "8.0.1"
  },
  "scripts": {
    "prestart": "node scripts/build-plants-json.js",
    "start": "react-scripts start",
    "serve": "serve -s build",
    "prebuild": "node scripts/build-plants-json.js",
    "build": "react-scripts build",
    "predeploy": "npm run build",
    "deploy": "firebase deploy",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-sass": "node-sass src/assets/scss/now-ui-kit.scss src/assets/css/now-ui-kit.css",
    "minify-sass": "node-sass src/assets/scss/now-ui-kit.scss src/assets/css/now-ui-kit.min.css --output-style compressed",
    "map-sass": "node-sass src/assets/scss/now-ui-kit.scss src/assets/css/now-ui-kit.css --source-map true"
  },
  "devDependencies": {
    "js-yaml": "^3.14.1"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "optionalDependencies": {
    "typescript": "3.5.3"
  }
}